# util
mjai_bot/mortal*

# Locally-built bot release artifacts
mortal.zip
*.bot.zip
tests/mortal_zip_layout.rs

# Test
test

# Local release helper
scripts/tag_release.sh

# Training-data shards written by native_bot's extractor (see native_bot/train/README.md).
# Tens of GB of intermediate binaries; the trained weights are what gets committed.
native_bot/out/

# Game logs the extractor reads, and the raw Tenhou logs they are converted from
# (see native_bot/train/README.md). Downloaded data, never committed.
native_bot/dataset/

# Mimosa security-scan history (see ~/.mimosa fallback when absent)
.mimosa

# ZCode session artifacts
.zcode/

# --- Mokora local data: never commit ---
# Per-account data (logins live in the browser profile), shared history,
# the local config and CA.
/accounts/
/history/
/configs/
/config.toml
/chrome-for-testing/
*.log
# Training data and outputs (hundreds of GB), per-machine venvs
native_bot/dataset/
native_bot/out/
native_bot/target/
native_bot/train/venv/
*.ckpt
# Scratch
/scratch/
/tmp/

# --- Local-only reference material (never pushed) ---
/_parked/original-assets/
/_parked/upstream-sync/
/_parked/api-key/
/target/

# Character icons fetched by scripts/fetch_characters.py (game artwork: local use only)
/assets/characters/

